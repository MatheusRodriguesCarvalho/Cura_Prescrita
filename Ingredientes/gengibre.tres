[resource]
script = ExtResource("1_t0wi3")
nome = "Gengibre"
descricao = "Raiz oriunda do sudeste asiático, comestível e ardida, muito utilizada em chás e como tempero. Sua versão em pó é ótima para gripes, resfriados e dores musuculares."
