[ext_resource type="Script" uid="uid://smyxvm5ki54q" path="res://Scripts/bases/base_noticia.gd" id="1_huo0u"]

[resource]
script = ExtResource("1_huo0u")
dia = 3
chamada = "Relatos de que a Lua estava esverdeada preocupa moradores do País de Vicus"
texto = "Os alunos do curso de Astronomia do País De Vicus alegam ter visto a coloração da lua mudar, descreveram como \"um tom de verde profundo e radiante, como esmeralda\". A SAM (Sociedade de Astronomia Mundial) investigou o caso, questionando outros observatórios e nenhuma mudança foi notada. Estudiosos marcaram viagem para o próximo dia, curiosos com as alegações dos alunos. No momento o caso se encontra aberto e sem conclusão lógica."
metadata/_custom_type_script = "uid://smyxvm5ki54q"
