[resource]
script = ExtResource("1_21yo3")
chamada = "Lua esverdeada preocupa moradores de Vicus"
texto = "Alunos do curso de Astronomia do país Vicus alegam ter visto a coloração da lua mudar, descreveram como \"um tom de verde profundo e radiante, como esmeralda\". A SAM (Sociedade de Astronomia Mundial) investigou o caso, questionando outros observatórios e nenhuma mudança foi notada. Estudiosos marcaram viagem para o próximo dia, curiosos com a descoberta de Vicus. No momento o caso se encontra aberto e sem conclusão lógica."
metadata/_custom_type_script = "uid://smyxvm5ki54q"
