[resource]
script = ExtResource("1_5m2t0")
nome = "Rosa Retorcida"
descricao = "Uma pesquisa recente descobriu que as folhas de Roseira Retorcida misturadas com pétalas desitradas resulta em um preparo excelente para doenças dos rins ou qualquer órgão que também percorra fluidos, como o estomago ou coração.
Quase todos os medicamentos que possuem uma alta proporção de Rosas Retorcidas em sua composição acabam sendo pós que necessitam diluição em água quente."
textura = ExtResource("2_u8o4r")
