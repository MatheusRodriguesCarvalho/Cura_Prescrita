script = ExtResource("1_1jmtv")
nome = "Casca de Jatobá"
descricao = "Ao retirar a casca do Jatobá e expô-la ao ar, a casca libera uma seiva pegajosa e grudenta, pode servir de base para xaropes medicinais.
Já o bagaço do Jatobá é rica em proteinas e expectorante naturais, e eram normalmente utilizados para tratar doenças pulmonares."
