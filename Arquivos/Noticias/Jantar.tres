[ext_resource type="Script" uid="uid://smyxvm5ki54q" path="res://Scripts/bases/base_noticia.gd" id="1_uyjul"]

[resource]
script = ExtResource("1_uyjul")
dia = 2
chamada = "De um jantar normal  à um mistério enigmático."
texto = "Um casal, que comemorava seu aniversário de namoro juntos, relatou para a polícia local que a residência foi invadida. Entretanto, ao investigar o local, nenhum sinal de arrombamento ou invasão foi encontrado. Mesmo sem tais provas, um dos agentes permaneceu com o casal por mais algumas horas, até que um barulho entregou que mais alguém estava ali. Ao se direcionar para à origem do barulho, o policial Miguel pode localizar um alçapão de madeira por debaixo de um piso solto e ao removerem, descobriram uma cadeia de tuneis, revestidos por raizes e folhas, onde, em uma rápida análise, se estimou que esses tuneis escondiam por baixo de toda a cidade.
Botânicos e Geógrafos foram convocados com urgência para avaliarem a situação incomum. Até o momento dessa notícia, ainda não temos informações sobre o que há neles além de terra, umidade e plantas."
metadata/_custom_type_script = "uid://smyxvm5ki54q"
