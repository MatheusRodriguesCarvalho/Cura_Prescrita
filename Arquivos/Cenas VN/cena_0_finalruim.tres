[sub_resource type="Resource" id="Resource_idpes"]
script = ExtResource("1_n5cp6")
nome = 4
texto = "A senhora recebeu uma carta, senhora Alê."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_luabi"]
script = ExtResource("1_n5cp6")
texto = "Muito obrigada, Minerva."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_bom3l"]
script = ExtResource("1_n5cp6")
nome = 3
texto = "“Querida Alê, 
Vimos que você deu conta de atender todos os pacientes que estavam atrasados durante esses 4 dias. Gostaríamos de parabenizá-la pelo seu desempenho, apesar de suas condições e da carga horária adaptada..."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_g4ko8"]
script = ExtResource("1_n5cp6")
nome = 3
texto = "Estamos entrando em contato para informar que semana que vem sua escala será de segunda a sexta permanecendo nesta clínica em Aresiens, mantendo seu horário adaptado.

Continue assim, 
Hospital Divina.”"
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_67xhv"]
script = ExtResource("1_n5cp6")
texto = "Ao menos posso continuar como médica… Vou melhorar algumas coisas por aqui e ali pela clínica."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_2vddn"]
script = ExtResource("1_n5cp6")
nome = 4
texto = "Você é a melhor médica que já passou por essa cidade, senhora Alê. Agradeço em nome de todos."
metadata/_custom_type_script = "uid://edt0act4c81l"

[resource]
