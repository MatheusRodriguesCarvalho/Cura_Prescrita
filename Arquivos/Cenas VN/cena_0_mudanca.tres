[sub_resource type="Resource" id="Resource_y5kkq"]
script = ExtResource("1_gqkhk")
nome = 1
texto = "Ahhh, mas por que estamos nos mudando? Justo agora que a professora ia começar a ensinar sobre robos."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_0fa0w"]
script = ExtResource("1_gqkhk")
texto = "Filha, a mamãe foi realocada para longe, não tinha muito que eu podesse fazer."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_o4k3g"]
script = ExtResource("1_gqkhk")
nome = 1
texto = "E por que não implicou com eles? Eles teriam mudado de ideia"
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_f344o"]
script = ExtResource("1_gqkhk")
nome = 2
texto = "Filhota, as coisas não são assim, sua mãe finalmente foi contratada pelo Instituto Divina, ela não poderia fazer essa birra. Ela poderia ter sido mandada embora."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_pgwya"]
script = ExtResource("1_gqkhk")
nome = 1
texto = "Eu sei... Mas não deixa de ser frustrante..."
metadata/_custom_type_script = "uid://edt0act4c81l"

