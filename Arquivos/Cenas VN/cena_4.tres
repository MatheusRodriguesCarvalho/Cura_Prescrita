[sub_resource type="Resource" id="Resource_l36np"]
script = ExtResource("1_j00w3")
nome = 2
texto = "Você está cada dia mais exausta e debilitada… Por que não tenta descansar um pouco?"
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_fxe08"]
script = ExtResource("1_j00w3")
texto = "Eu consigo lidar com isso, não é como se o cursinho não tivesse sido pesado assim… E também, eu quero que nossa filha e você vivam bem."
metadata/_custom_type_script = "uid://edt0act4c81l"

[sub_resource type="Resource" id="Resource_j3d3j"]
script = ExtResource("1_j00w3")
nome = 2
texto = "Tente priorizar a sua saúde, Alê,
se não, não conseguirá prometer que consegue lidar com a pressão."
metadata/_custom_type_script = "uid://edt0act4c81l"

